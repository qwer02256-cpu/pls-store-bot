# Enter real credentials only in the local .env or hosting environment settings.
BOT_TOKEN=
ADMIN_ID=
SUPPORT_USERNAME=
REVIEWS_URL=
DB_PATH=data/store.db

PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_POLL_INTERVAL=30
# Optional: public HTTPS callback base. API polling works with this left empty.
PLATEGA_CALLBACK_BASE=
PLATEGA_CALLBACK_PORT=8080

# HTTPS origin for license verification on the SAME aiohttp server/port.
# Defaults to PLATEGA_CALLBACK_BASE when omitted. No trailing path.
# LICENSE_PUBLIC_BASE=https://your-public-bothost-domain.example
